{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshot Tool SSAI",
  "version": "0.1.0",
  "identifier": "com.tlreddy.screenshot-tool-ssai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Screenshot Tool SSAI",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": [
      "binaries/screenshot-backend"
    ],
    "resources": [
      "resources/*"
    ]
  }
}
